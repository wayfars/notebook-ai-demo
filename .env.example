# OpenAI-compatible Chat Completions API (local or hosted)
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=local
OPENAI_MODEL=local-model
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_TOKENS=512

# Optional path; defaults to data/notebook.sqlite3
# NOTEBOOK_DB_PATH=data/notebook.sqlite3

# Separate learning-workspace database; never point this at NOTEBOOK_DB_PATH.
# NOTEBOOK_LEARNING_DB_PATH=~/.local/share/notebook-learning/learning.sqlite3
# Optional learning-only overrides; otherwise OPENAI_* settings above apply.
# NOTEBOOK_LEARNING_BASE_URL=http://127.0.0.1:8000/v1
# NOTEBOOK_LEARNING_API_KEY=local
# NOTEBOOK_LEARNING_MODEL=local-model
